+    // Helper: make a float32 tensor unaligned by copying its data into a byte storage 
+    // and returning a view whose data pointer is offset by 1-3 bytes.
+    void apply_unalignment(torch::Tensor &t, int offset_bytes) {
+        if (t.dtype() != torch::kFloat32) return; // only float32 is relevant for the known bug
+        int64_t numel = t.numel();
+        if (numel == 0) return;
+        int64_t byte_size = numel * t.element_size(); // = numel * 4
+        // Create a byte storage with extra space so we can offset the start
+        auto storage = torch::empty({byte_size + static_cast<int64_t>(offset_bytes)}, torch::kUInt8);
+        std::memcpy(storage.data_ptr<uint8_t>() + offset_bytes, t.data_ptr<float>(), byte_size);
+        // Take a slice that starts at the offset and has the exact number of bytes needed
+        auto slice = storage.narrow(0, offset_bytes, byte_size);
+        // Reinterpret the bytes as float32 and then reshape to the original tensor shape
+        t = slice.view(torch::kFloat32).view(t.sizes());
+    }
