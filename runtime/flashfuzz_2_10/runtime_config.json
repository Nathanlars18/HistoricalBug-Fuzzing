{
  "config_version": "0.1",
  "state": "fuzz_and_coverage_smoke_passed",
  "purpose": "PyTorch 2.10 CPU runtime shared by all formal experiment groups.",
  "source_inputs": {
    "flashfuzz": {
      "path": "third_party/FlashFuzz",
      "base_commit": "c1c752963596528e4752360cdaeac77a80f7e07d",
      "modification_policy": "keep_clean_use_project_owned_overlay"
    },
    "pytorch": {
      "tag": "v2.10.0",
      "commit": "449b1768410104d3ed79d3bcfe4ba1d65c7f22c0",
      "source_repository": "https://github.com/pytorch/pytorch.git"
    }
  },
  "scope": {
    "device": "cpu",
    "framework_build": "debug_instrumented",
    "supported_execution_modes": [
      "fuzz",
      "coverage"
    ],
    "coverage_runtime": "built_and_smoke_tested"
  },
  "images": {
    "base": "historicalbug/flashfuzz:torch2.10-base",
    "fuzz_runtime": "historicalbug/flashfuzz:torch2.10-fuzz-runtime",
    "coverage_runtime": "historicalbug/flashfuzz:torch2.10-cov-runtime",
    "api_metadata_runtime": "historicalbug/flashfuzz:torch2.10-api-metadata"
  },
  "resource_policy": {
    "initial_pytorch_build_jobs": 2,
    "increase_parallelism_before_smoke_pass": false,
    "docker_memory_limit_per_experiment": null,
    "rationale": "The current WSL allocation is 12 GB memory; start conservatively and record observed usage before changing limits."
  },
  "path_contract": {
    "pytorch_source": "/root/pytorch",
    "pytorch_fuzz_build": "/root/pytorch/build-fuzz",
    "pytorch_coverage_build": "/root/pytorch/build-cov",
    "mounted_harness_root": "/root/fuzz/torch_cpu",
    "execution_workspace": "/workspace"
  },
  "evidence_policy": {
    "record_after_build": [
      "image_id",
      "image_digest",
      "dockerfile_sha256",
      "pytorch_runtime_version",
      "compiler_versions",
      "cmake_configuration",
      "smoke_test_result"
    ],
    "do_not_record_as_observed_before_build": true
  }
}
