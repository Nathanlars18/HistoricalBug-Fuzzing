      "evidence_kind": "bug_description",
      "locator": {
        "locator_type": "line_range",
        "start_line": 54,
        "end_line": 65
      },
      "excerpt": "Description:\n\nThe internal aten::_softmax.out implementation produces incorrect results\nwhen the output tensor provided through the out parameter is non-contiguous.\n\nThe generated output is partially written into incorrect memory locations,\ncausing some elements to remain unchanged.\n\nThe resulting tensor contains invalid softmax values,\nincluding negative values that should never appear in softmax output.\n\n",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:272c0384d096edbc55aade1a6c04849b23699fa6e08755213f4890b606c8aa29"
    },
