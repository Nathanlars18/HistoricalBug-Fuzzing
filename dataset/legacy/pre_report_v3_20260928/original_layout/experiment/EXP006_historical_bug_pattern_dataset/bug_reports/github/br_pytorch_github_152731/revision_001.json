      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "observed_output",
      "locator": {
        "locator_type": "line_range",
        "start_line": 66,
        "end_line": 78
      },
      "excerpt": "Observed:\n\nCPU:\n\nRuntimeError:\nvalue cannot be converted to type at::Half without overflow\n\n\nCUDA:\n\nOperation succeeds silently.\n\n",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
