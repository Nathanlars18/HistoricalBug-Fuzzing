    {
      "evidence_id": "ev_art_primary_report_bug_description_0c50220f8d7e",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "bug_description",
      "locator": {
        "locator_type": "line_range",
        "start_line": 32,
        "end_line": 51
      },
      "excerpt": "Description:\n\n🐛 Describe the bug\n\ntorch.mul causes segmentation fault when multiplying a normal float16 tensor with an empty float16 tensor converted from a NumPy array.\n\nMinimal reproducer:\n\nimport numpy as np\nimport torch\n\na = torch.tensor([2], dtype=torch.float16)\n\nb = torch.tensor(np.array([], dtype='float16'))\n\nprint(torch.mul(a, b))\n\n# print(torch.div(a, b))\n\n",
      "attribution": {
        "actor": "@AmazingCreator-lmx",
        "actor_role": "reporter"
      },
      "content_hash": "sha256:81c7331e468e213d03aa54428a374d6b3324f9b0413d7e48dcf7d1827cc9ea82"
    },
    {
      "evidence_id": "ev_art_primary_report_observed_output_49b9b08ccf6a",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "observed_output",
      "locator": {
        "locator_type": "line_range",
        "start_line": 52,
        "end_line": 58
      },
      "excerpt": "Observed behavior:\n\nThe program crashes with segmentation fault:\n\npython[2444066]: segfault at 0 ip 00007f8c393f8fa0 sp 00007fff645121c0 error 4 in libtorch_cpu.so\n\n",
      "attribution": {
        "actor": "@AmazingCreator-lmx",
        "actor_role": "reporter"
      },
      "content_hash": "sha256:102b10c6492e2647fc0e7edf317c1e23e3283ed79403b3e4a06572c6f870f8da"
    },
    {
      "evidence_id": "ev_art_primary_report_api_reference_1fe6faa83d8e",
