    {
      "evidence_id": "ev_art_primary_report_bug_description_1c69e4b17a93",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "bug_description",
      "locator": {
        "locator_type": "line_range",
        "start_line": 11,
        "end_line": 17
      },
      "excerpt": "Description:\n\n🐛 Describe the bug\n\ntorch.softmax(torch.zeros(c,781, dtype=torch.float64, device='cuda'),dim=1) gives wrong answer for c > 1.\n\n",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:afcb08d68357987e44d8399cd73ae72a9f429cd66f3c5f5c857381ec9d09f5d2"
    },
    {
      "evidence_id": "ev_art_primary_report_observed_output_8f287ca4c8de",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "observed_output",
      "locator": {
        "locator_type": "line_range",
        "start_line": 36,
        "end_line": 41
      },
      "excerpt": "Observed behavior:\nThe output values are incorrect when:\n- device is CUDA\n- dtype is float64\n- number of rows is greater than 1\n- dimension size is 781",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:56f81cc89fd444ab1810b20f3ef3c7f37533300e8d8c65f8223bb7dada058b52"
    },
    {
      "evidence_id": "ev_art_primary_report_api_reference_a39f708209a7",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "api_reference",
      "locator": {
        "locator_type": "line_range",
        "start_line": 1,
        "end_line": 3
      },
      "excerpt": "Title:\ntorch.softmax gives wierd result under specific condition on cuda double tensors with multiple rows and 781 columns.\n",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:2750fbb9b6b62e6c2f24b8d1b2281625ce724c265946a9674b6cd70f8ddea16a"
    },
    {
      "evidence_id": "ev_art_primary_report_reproduction_38620e1bf39e",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "reproduction",
      "locator": {
        "locator_type": "line_range",
        "start_line": 18,
        "end_line": 35
      },
      "excerpt": "Reproduction:\n\n```python\nimport torch\n\nprint(torch.softmax(torch.zeros(1,781, dtype=torch.float64, device='cuda'),dim=1)) # correct\n\nprint(torch.softmax(torch.zeros(2,781, dtype=torch.float64, device='cuda'),dim=1)) # wrong\n\nprint(torch.softmax(torch.zeros(3,781, dtype=torch.float64, device='cuda'),dim=1)) # wrong\n\nprint(torch.softmax(torch.zeros(4,781, dtype=torch.float64, device='cuda'),dim=1)) # wrong\n\nprint(torch.softmax(torch.zeros(5,781, dtype=torch.float64, device='cuda'),dim=1)) # wrong\n\nprint(torch.softmax(torch.zeros(2,780, dtype=torch.float64, device='cuda'),dim=1)) # correct\n\nprint(torch.softmax(torch.zeros(2,782, dtype=torch.float64, device='cuda'),dim=1)) # correct",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:15a9d7c1ae0873ab96f3a095f83d5f35c56310d3be181036e34bcd90a0a7b58e"
    },
    {
      "evidence_id": "ev_art_primary_report_expected_behavior_4dc1f794b03b",
      "source_artifact_ref": "art_primary_report",
      "evidence_kind": "expected_behavior",
      "locator": {
        "locator_type": "line_range",
        "start_line": 42,
        "end_line": 53
      },
      "excerpt": "Expected behavior:\nThe output of softmax should be a valid probability distribution where each row sums to 1.\nAdditional investigation:\nThe issue appears to be CUDA-specific and related to the float64 implementation of softmax.\nWorkarounds:\n1. Use float32 instead of float64:\ntensor = torch.zeros(c, 781, dtype=torch.float32, device=\"cuda\")\n2. Compute softmax on CPU:\nresult = torch.softmax(tensor.cpu(), dim=1).cuda()\n3. Pad the dimension:\ntensor = torch.zeros(c, 782, dtype=torch.float64, device=\"cuda\")\nresult = torch.softmax(tensor, dim=1)",
      "attribution": {
        "actor": null,
        "actor_role": "reporter"
      },
      "content_hash": "sha256:22951d3522b383e69072adf6e9c2a200da43d0767e43849e4ecfb97bb45bc1ac"
    },
