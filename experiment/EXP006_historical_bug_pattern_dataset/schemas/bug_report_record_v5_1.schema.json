{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:historicalbug-fuzzing:schema:bug-report-record:5.1",
  "title": "Historical Bug Report Record v5.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "identity", "revision_information", "source_bundle",
    "evidence_items", "scope_assertions", "reported_behavior",
    "reported_diagnosis", "resolution", "upstream_disposition",
    "unresolved_information", "provenance", "review"
  ],
  "properties": {
    "schema_version": {"const": "5.1"},
    "identity": {"$ref": "#/$defs/identity"},
    "revision_information": {"$ref": "#/$defs/revision"},
    "source_bundle": {"$ref": "#/$defs/source_bundle"},
    "evidence_items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "scope_assertions": {"$ref": "#/$defs/scope"},
    "reported_behavior": {"$ref": "#/$defs/behavior"},
    "reported_diagnosis": {"$ref": "#/$defs/diagnosis"},
    "resolution": {"$ref": "#/$defs/resolution"},
    "upstream_disposition": {"$ref": "#/$defs/upstream_disposition"},
    "unresolved_information": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unresolved"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "if": {"properties": {"review": {"properties": {"human_review_status": {"const": "approved"}}, "required": ["human_review_status"]}}},
      "then": {
        "properties": {
          "scope_assertions": {"properties": {"api_assertions": {"contains": {"properties": {"relation": {"const": "affected"}}, "required": ["relation"]}, "minContains": 1}}},
          "reported_behavior": {
            "properties": {"failure_observations": {"minItems": 1}},
            "anyOf": [
              {"properties": {"trigger_claims": {"minItems": 1}}},
              {"properties": {"operation_contexts": {"minItems": 1}}},
              {"properties": {"reproduction": {"properties": {"source_evidence_refs": {"minItems": 1}}}}}
            ]
          },
          "review": {
            "properties": {
              "validation_status": {"const": "passed"},
              "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 500},
              "reviewed_at": {"$ref": "#/$defs/timestamp"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"properties": {"status": {"enum": ["fixed", "fix_proposed", "no_fix"]}}, "required": ["status"]}}},
      "then": {"properties": {"resolution": {"properties": {"resolution_claims": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"resolution": {"properties": {"status": {"enum": ["fixed", "fix_proposed"]}}, "required": ["status"]}}},
      "then": {"properties": {"resolution": {"properties": {"fix_artifact_refs": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 8000},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "nonempty_reference_array": {"allOf": [{"$ref": "#/$defs/reference_array"}, {"minItems": 1}]},
    "file_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["local_path", "content_hash"],
      "properties": {
        "local_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "record_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_version", "content_hash"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_version": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "repository", "issue_number", "canonical_url"],
      "properties": {
        "report_id": {"$ref": "#/$defs/identifier"},
        "repository": {"$ref": "#/$defs/short_text"},
        "issue_number": {"type": "integer", "minimum": 1},
        "canonical_url": {"type": "string", "format": "uri"}
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_number", "parent_revision_ref", "revision_trigger"],
      "properties": {
        "revision_number": {"type": "integer", "minimum": 1},
        "parent_revision_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_ref"}]},
        "revision_trigger": {"enum": ["initial_mapping", "source_updated", "mapping_updated", "review_updated"]}
      }
    },
    "source_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_role", "source_kind", "local_path", "content_hash", "source_native_state", "captured_at"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_role": {"enum": ["issue", "comment_thread", "reproduction", "diagnosis", "resolution", "curation"]},
        "source_kind": {"enum": ["github_issue", "github_comments", "github_pull_request", "github_commit", "dataset_record", "other"]},
        "local_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "external_id": {"type": ["string", "null"], "maxLength": 500},
        "url": {"type": ["string", "null"], "format": "uri"},
        "source_native_state": {"enum": ["open", "closed", "merged", "other", "unknown", null]},
        "captured_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}
      }
    },
    "source_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_ref", "primary_source_ref", "comments_capture_status", "source_artifacts"],
      "properties": {
        "inventory_ref": {"$ref": "#/$defs/file_ref"},
        "primary_source_ref": {"$ref": "#/$defs/identifier"},
        "comments_capture_status": {"enum": ["complete", "partial", "unavailable"]},
        "source_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source_artifact"}}
      }
    },
    "locator": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["locator_type", "value"], "properties": {"locator_type": {"const": "json_pointer"}, "value": {"type": "string", "pattern": "^/", "maxLength": 2048}}},
        {"type": "object", "additionalProperties": false, "required": ["locator_type", "value", "start_line", "end_line"], "properties": {"locator_type": {"const": "json_string_line_range"}, "value": {"type": "string", "pattern": "^/", "maxLength": 2048}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}}}
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_artifact_ref", "locator", "excerpt", "content_hash"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "source_artifact_ref": {"$ref": "#/$defs/identifier"},
        "locator": {"$ref": "#/$defs/locator"},
        "excerpt": {"type": ["string", "null"], "maxLength": 4000},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "basis": {"enum": ["source_explicit", "code_explicit", "patch_explicit"]},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "statement", "assertion_basis", "evidence_refs"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/identifier"},
        "statement": {"$ref": "#/$defs/text"},
        "assertion_basis": {"$ref": "#/$defs/basis"},
        "evidence_refs": {"$ref": "#/$defs/nonempty_reference_array"}
      }
    },
    "api_assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["assertion_id", "api_name", "relation", "assertion_basis", "evidence_refs"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "api_name": {"$ref": "#/$defs/short_text"},
        "relation": {"enum": ["affected", "mentioned"]},
        "assertion_basis": {"$ref": "#/$defs/basis"},
        "evidence_refs": {"$ref": "#/$defs/nonempty_reference_array"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["api_assertions"],
      "properties": {"api_assertions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/api_assertion"}}}
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["availability", "source_evidence_refs", "validation_status"],
      "properties": {
        "availability": {"enum": ["code_provided", "steps_provided", "not_provided", "unknown"]},
        "source_evidence_refs": {"$ref": "#/$defs/reference_array"},
        "validation_status": {"enum": ["not_attempted", "passed", "failed", "not_applicable"]}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"enum": ["code_provided", "steps_provided"]}}, "required": ["availability"]}, "then": {"properties": {"source_evidence_refs": {"minItems": 1}}}},
        {"if": {"properties": {"availability": {"const": "not_provided"}}, "required": ["availability"]}, "then": {"properties": {"source_evidence_refs": {"maxItems": 0}}}}
      ]
    },
    "environment_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "name", "value", "evidence_refs"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/short_text"},
        "value": {"$ref": "#/$defs/text"},
        "evidence_refs": {"$ref": "#/$defs/nonempty_reference_array"}
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger_claims", "operation_contexts", "failure_observations", "expected_behavior_claims", "historical_oracle_claims", "environment_facts", "reproduction"],
      "properties": {
        "trigger_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "operation_contexts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "failure_observations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "expected_behavior_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "historical_oracle_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "environment_facts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/environment_fact"}},
        "reproduction": {"$ref": "#/$defs/reproduction"}
      }
    },
    "root_cause_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "statement", "support_status", "assertion_basis", "evidence_refs"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/identifier"},
        "statement": {"$ref": "#/$defs/text"},
        "support_status": {"enum": ["reported", "confirmed_upstream", "disputed"]},
        "assertion_basis": {"$ref": "#/$defs/basis"},
        "evidence_refs": {"$ref": "#/$defs/nonempty_reference_array"}
      }
    },
    "diagnosis": {
      "type": "object", "additionalProperties": false,
      "required": ["root_cause_claims"],
      "properties": {"root_cause_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/root_cause_claim"}}}
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "resolution_claims", "fix_artifact_refs"],
      "properties": {
        "status": {"enum": ["fixed", "fix_proposed", "no_fix", "unknown"]},
        "resolution_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "fix_artifact_refs": {"$ref": "#/$defs/reference_array"}
      }
    },
    "upstream_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["reported", "triaged_as_bug", "confirmed_bug", "disputed", "expected_behavior", "unknown"]},
        "evidence_refs": {"$ref": "#/$defs/reference_array"}
      },
      "allOf": [{"if": {"properties": {"status": {"not": {"const": "unknown"}}}, "required": ["status"]}, "then": {"properties": {"evidence_refs": {"minItems": 1}}}}]
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["unresolved_id", "field_path", "description", "reason", "evidence_refs"],
      "properties": {
        "unresolved_id": {"$ref": "#/$defs/identifier"},
        "field_path": {"type": "string", "pattern": "^/", "maxLength": 2048},
        "description": {"$ref": "#/$defs/text"},
        "reason": {"enum": ["missing_source", "not_collected", "ambiguous_source", "conflicting_sources", "unsupported_format", "other"]},
        "evidence_refs": {"$ref": "#/$defs/reference_array"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["builder_id", "builder_version", "generation_run_id", "input_artifact_refs", "mapping_ref", "generated_at", "content_hash"],
      "properties": {
        "builder_id": {"const": "build_bug_report_json"},
        "builder_version": {"$ref": "#/$defs/short_text"},
        "generation_run_id": {"$ref": "#/$defs/identifier"},
        "input_artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
        "mapping_ref": {"$ref": "#/$defs/file_ref"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_status", "validation_issues", "human_review_status", "reviewed_by", "reviewed_at"],
      "properties": {
        "validation_status": {"enum": ["passed", "failed"]},
        "validation_issues": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "human_review_status": {"enum": ["not_reviewed", "approved", "rejected"]},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 500},
        "reviewed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}
      }
    }
  }
}
