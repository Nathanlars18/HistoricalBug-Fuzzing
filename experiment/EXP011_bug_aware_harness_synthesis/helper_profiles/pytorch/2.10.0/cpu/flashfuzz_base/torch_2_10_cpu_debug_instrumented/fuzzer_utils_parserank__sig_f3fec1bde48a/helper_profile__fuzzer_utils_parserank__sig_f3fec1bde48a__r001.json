      "excerpt": "parseRank(uint8_t byte)\n    {\n        constexpr uint8_t range = MAX_RANK - MIN_RANK + 1;\n        uint8_t rank = byte % range + MIN_RANK;\n#ifdef DEBUG_FUZZ\n        std::cout << \"Rank byte: \" << static_cast<int>(byte) << \", rank: \" << static_cast<int>(rank) << std::endl;\n#endif\n        return rank;\n    }",
