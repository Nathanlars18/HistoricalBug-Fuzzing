      "content_hash": "e7d8aa99691fbbc38d8eef5bc49a1302ad10672bd98cdfec3273e8eb68add368",
      "excerpt": "saveDiffInput(const uint8_t *data, size_t size, const std::string &timestamp)\n    {\n        if (!ensure_log_directory_exists())\n            return;\n        std::ofstream ofs(\"diff_inputs.log\", std::ios::app | std::ios::binary);\n        if (!ofs)\n        {\n            std::cerr << \"Warning: Unable to open diff_inputs.log to log difference input.\" << std::endl;\n            return;\n        }\n        \n        ofs << \"Timestamp: \" << timestamp << \"\\n\";\n        ofs.write(reinterpret_cast<const char *>(data), size);\n        ofs << separator;\n    }",
      "collected_at": "2026-09-14T08:03:04.293427Z"
    },
