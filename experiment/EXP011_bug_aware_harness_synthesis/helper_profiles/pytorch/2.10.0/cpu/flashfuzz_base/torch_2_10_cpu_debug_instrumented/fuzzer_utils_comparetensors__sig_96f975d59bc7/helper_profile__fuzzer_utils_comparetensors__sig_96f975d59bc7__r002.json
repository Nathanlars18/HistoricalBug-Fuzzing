      "evidence_id": "ev_helper_implementation",
      "source_kind": "helper_implementation",
      "source_location": "third_party/FlashFuzz/testharness_generation/torch_cpu/torch_cpu_helper/fuzzer_utils.cpp",
      "source_revision": "c1c752963596528e4752360cdaeac77a80f7e07d",
      "locator": "fuzzer_utils::compareTensors",
      "content_hash": "e7d8aa99691fbbc38d8eef5bc49a1302ad10672bd98cdfec3273e8eb68add368",
      "excerpt": "compareTensors(const torch::Tensor &t1, const torch::Tensor &t2, const uint8_t *data, size_t size, double rtol, double atol)\n    {\n        \n        if (t1.sizes() != t2.sizes())\n        {\n            std::cerr << \"Shape mismatch: \" << t1.sizes() << \" vs \" << t2.sizes() << std::endl;\n        }\n\n        \n        if (t1.dtype() != t2.dtype())\n        {\n            std::cerr << \"Dtype mismatch: \" << t1.dtype() << \" vs \" << t2.dtype() << std::endl;\n        }\n\n        bool is_close = torch::allclose(t1, t2, rtol, atol);\n\n        if (!is_close)\n        {\n            \n            auto abs_diff = torch::abs(t1 - t2);\n            auto max_diff = torch::max(abs_diff).item<float>();\n            auto max_val = std::max(torch::max(torch::abs(t1)).item<float>(),\n                                    torch::max(torch::abs(t2)).item<float>());\n\n            std::cerr << \"Max difference: \" << max_diff << \" (relative to max value: \"\n                      << (max_val > 0 ? max_diff / max_val : max_diff) << \"",
      "collected_at": "2026-09-14T08:03:04.293427Z"
    },
