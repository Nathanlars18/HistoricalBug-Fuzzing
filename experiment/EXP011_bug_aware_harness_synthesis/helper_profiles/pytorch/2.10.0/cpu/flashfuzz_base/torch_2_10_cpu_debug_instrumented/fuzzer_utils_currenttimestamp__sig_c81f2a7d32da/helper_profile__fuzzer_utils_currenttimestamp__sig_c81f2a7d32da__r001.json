      "content_hash": "e7d8aa99691fbbc38d8eef5bc49a1302ad10672bd98cdfec3273e8eb68add368",
      "excerpt": "currentTimestamp()\n    {\n        using namespace std::chrono;\n        auto now = system_clock::now();\n        auto time = system_clock::to_time_t(now);\n        std::tm tm;\n#if defined(_MSC_VER)\n        localtime_s(&tm, &time);\n#else\n        localtime_r(&time, &tm);\n#endif\n        std::ostringstream oss;\n        oss << std::put_time(&tm, \"%Y-%m-%d %H:%M:%S\");\n        return oss.str();\n    }",
