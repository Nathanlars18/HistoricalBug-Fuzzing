{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:historicalbug-fuzzing:schema:strategy-plan-record:1.1",
  "title": "HistoricalBug-Fuzzing Strategy Plan Record v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "revision_information",
    "source_context",
    "implementation_plan",
    "provenance",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "revision_information": {
      "$ref": "#/$defs/revision_information"
    },
    "source_context": {
      "$ref": "#/$defs/source_context"
    },
    "implementation_plan": {
      "$ref": "#/$defs/implementation_plan"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullable_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_timestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "json_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      ]
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "content_hash"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/positive_integer"
            },
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "harness_spec_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "revision_number",
        "content_hash"
      ],
      "properties": {
        "spec_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision_number": {
          "$ref": "#/$defs/positive_integer"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "strategy_catalog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "catalog_version",
        "content_hash"
      ],
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/identifier"
        },
        "catalog_version": {
          "$ref": "#/$defs/positive_integer"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "strategy_revision_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "revision_number",
        "content_hash"
      ],
      "properties": {
        "strategy_id": {
          "$ref": "#/$defs/identifier"
        },
        "revision_number": {
          "$ref": "#/$defs/positive_integer"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "framework",
        "target_api",
        "spec_mode"
      ],
      "properties": {
        "strategy_id": {
          "$ref": "#/$defs/identifier"
        },
        "framework": {
          "$ref": "#/$defs/identifier"
        },
        "target_api": {
          "$ref": "#/$defs/non_empty_string"
        },
        "spec_mode": {
          "enum": [
            "controlled_baseline",
            "bug_aware_static",
            "bug_aware_adaptive"
          ]
        }
      }
    },
    "revision_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_number",
        "parent_revision_ref",
        "revision_trigger",
        "change_scopes",
        "change_summary"
      ],
      "properties": {
        "revision_number": {
          "$ref": "#/$defs/positive_integer"
        },
        "parent_revision_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/strategy_revision_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_trigger": {
          "enum": [
            "initial_creation",
            "validation_repair",
            "compile_repair",
            "catalog_update",
            "manual_review",
            "regeneration"
          ]
        },
        "change_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "initial_definition",
              "primitive_selection",
              "dataflow",
              "parameter_binding",
              "template_placement",
              "failure_handling",
              "spec_binding",
              "source_context",
              "metadata_only"
            ]
          }
        },
        "change_summary": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_number": {
                "const": 1
              }
            },
            "required": [
              "revision_number"
            ]
          },
          "then": {
            "properties": {
              "parent_revision_ref": {
                "type": "null"
              },
              "revision_trigger": {
                "const": "initial_creation"
              },
              "change_scopes": {
                "contains": {
                  "const": "initial_definition"
                },
                "minContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "parent_revision_ref": {
                "$ref": "#/$defs/strategy_revision_reference"
              },
              "revision_trigger": {
                "enum": [
                  "validation_repair",
                  "compile_repair",
                  "catalog_update",
                  "manual_review",
                  "regeneration"
                ]
              },
              "change_scopes": {
                "not": {
                  "contains": {
                    "const": "initial_definition"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "change_scopes": {
                "contains": {
                  "const": "metadata_only"
                }
              }
            },
            "required": [
              "change_scopes"
            ]
          },
          "then": {
            "properties": {
              "change_scopes": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_spec_ref",
        "strategy_catalog_ref",
        "derived_from_strategy_ref"
      ],
      "properties": {
        "harness_spec_ref": {
          "$ref": "#/$defs/harness_spec_reference"
        },
        "strategy_catalog_ref": {
          "$ref": "#/$defs/strategy_catalog_reference"
        },
        "derived_from_strategy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/strategy_revision_reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "implementation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_strategies"
      ],
      "properties": {
        "branch_strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/branch_strategy"
          }
        }
      }
    },
    "branch_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_branch_id",
        "steps",
        "spec_bindings",
        "failure_handlers"
      ],
      "properties": {
        "source_branch_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/strategy_step"
          }
        },
        "spec_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/spec_binding"
          }
        },
        "failure_handlers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failure_handler"
          }
        }
      }
    },
    "strategy_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "primitive_id",
        "template_slot",
        "input_bindings",
        "parameter_bindings",
        "output_bindings"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/identifier"
        },
        "primitive_id": {
          "$ref": "#/$defs/identifier"
        },
        "template_slot": {
          "enum": [
            "input_construction",
            "pre_call_transform",
            "pre_call_guard",
            "pre_call_observation",
            "target_call",
            "post_call_observation",
            "oracle_check",
            "artifact_logging",
            "cleanup"
          ]
        },
        "input_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/input_binding"
          }
        },
        "parameter_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parameter_binding"
          }
        },
        "output_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/output_binding"
          }
        }
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "value_ref"
      ],
      "properties": {
        "port_id": {
          "$ref": "#/$defs/identifier"
        },
        "value_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "output_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "value_id"
      ],
      "properties": {
        "port_id": {
          "$ref": "#/$defs/identifier"
        },
        "value_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "parameter_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "binding_kind",
        "binding_value"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/identifier"
        },
        "binding_kind": {
          "enum": [
            "literal",
            "value_ref",
            "spec_parameter"
          ]
        },
        "binding_value": {
          "$ref": "#/$defs/json_value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_kind": {
                "const": "value_ref"
              }
            },
            "required": [
              "binding_kind"
            ]
          },
          "then": {
            "properties": {
              "binding_value": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_kind": {
                "const": "spec_parameter"
              }
            },
            "required": [
              "binding_kind"
            ]
          },
          "then": {
            "properties": {
              "binding_value": {
                "$ref": "#/$defs/spec_parameter_reference"
              }
            }
          }
        }
      ]
    },
    "spec_parameter_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_element_type",
        "spec_element_id",
        "parameter_name"
      ],
      "properties": {
        "spec_element_type": {
          "enum": [
            "global_constraint",
            "branch_constraint",
            "branch_precondition",
            "target_property",
            "oracle_requirement"
          ]
        },
        "spec_element_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "parameter_name": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "spec_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_element_type",
        "spec_element_id",
        "implementation_step_ids"
      ],
      "properties": {
        "spec_element_type": {
          "enum": [
            "global_constraint",
            "branch_constraint",
            "branch_precondition",
            "target_property",
            "activation_target",
            "oracle_requirement"
          ]
        },
        "spec_element_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "implementation_step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "failure_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "outcome_id"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/identifier"
        },
        "outcome_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "failure_handler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_handler_id",
        "trigger",
        "terminal_action"
      ],
      "properties": {
        "failure_handler_id": {
          "$ref": "#/$defs/identifier"
        },
        "trigger": {
          "$ref": "#/$defs/failure_trigger"
        },
        "terminal_action": {
          "enum": [
            "reject_input",
            "record_and_return"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_method",
        "generator_name",
        "model_name",
        "generation_run_id",
        "script_ref",
        "contract_ref",
        "rules_ref",
        "generated_at"
      ],
      "properties": {
        "generation_method": {
          "enum": [
            "manual",
            "script",
            "llm",
            "hybrid"
          ]
        },
        "generator_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "model_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "generation_run_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "script_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_ref": {
          "$ref": "#/$defs/artifact_reference"
        },
        "rules_ref": {
          "$ref": "#/$defs/artifact_reference"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "validation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_code",
        "severity",
        "field_path",
        "message"
      ],
      "properties": {
        "issue_code": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "field_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_status",
        "validation_issues",
        "human_review_status",
        "reviewer_id",
        "reviewed_at",
        "review_notes"
      ],
      "properties": {
        "validation_status": {
          "enum": [
            "not_validated",
            "passed",
            "failed"
          ]
        },
        "validation_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/validation_issue"
          }
        },
        "human_review_status": {
          "enum": [
            "not_reviewed",
            "approved",
            "needs_revision"
          ]
        },
        "reviewer_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "reviewed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "review_notes": {
          "$ref": "#/$defs/nullable_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_review_status": {
                "const": "approved"
              }
            },
            "required": [
              "human_review_status"
            ]
          },
          "then": {
            "properties": {
              "validation_status": {
                "const": "passed"
              },
              "reviewer_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "reviewed_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "human_review_status": {
                "const": "not_reviewed"
              }
            },
            "required": [
              "human_review_status"
            ]
          },
          "then": {
            "properties": {
              "reviewer_id": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              },
              "review_notes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "human_review_status": {
                "const": "needs_revision"
              }
            },
            "required": [
              "human_review_status"
            ]
          },
          "then": {
            "properties": {
              "reviewer_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "reviewed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "review_notes": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validation_status": {
                "const": "passed"
              }
            },
            "required": [
              "validation_status"
            ]
          },
          "then": {
            "properties": {
              "validation_issues": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "severity": {
                        "const": "error"
                      }
                    },
                    "required": [
                      "severity"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validation_status": {
                "const": "failed"
              }
            },
            "required": [
              "validation_status"
            ]
          },
          "then": {
            "properties": {
              "validation_issues": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }
}