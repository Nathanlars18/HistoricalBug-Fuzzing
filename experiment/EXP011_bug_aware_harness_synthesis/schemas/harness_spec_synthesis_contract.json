    "resolution_id": "res_<nnn>",
    "effect_id": "eff_<resolution_number>_<nn>",
    "global_constraint_id": "gc_<nnn>",
    "branch_local_id": "<bc|tp|pre|act|orc>_<branch_id>_<nn>"
  },

  "builder_materialization": {
    "candidate_decision.knowledge_id": "Replace with the exact Knowledge Reference from the Candidate Manifest.",
    "source_ref": "Attach the exact source revision or version and content hash.",
    "exploration_plan.default_branch_id": "Set to the branch_id of the unique branch whose branch_kind is default.",
    "exploration_plan.branches[].budget_share": "Assign deterministically from config budget_policy and normalize all branch shares to 1.",
    "local_identifiers": "Normalize identifier prefixes and numbering, rewrite internal references, and preserve unchanged identifiers across revisions."
  },

  "placeholder_policy": {
    "null_placeholders": "Null values in templates are not default decisions. Replace them unless the final HarnessSpec Schema permits null.",
    "empty_arrays": "Use an empty array only when the corresponding cardinality and structural constraints allow it.",
    "placeholder_objects": "Do not copy unpopulated template objects into the response."
  },

  "output_constraints": [
    "Return only fields shown by response_template and item_templates.",
    "Use only Candidate Manifest Knowledge IDs and supplied source IDs.",
    "Every required local identifier and human-readable summary must be non-empty.",
    "Exactly one branch with branch_kind default must exist; the Builder derives default_branch_id from it.",
    "Do not emit budget_share; the Builder assigns positive shares from budget_policy and normalizes their sum to 1.",
    "Do not include full source records, source code, Helper calls, Strategy Primitives, or hidden reasoning.",
    "Cross-field and reference invariants not listed here are enforced by the Validator against the final HarnessSpec Schema."
  ]
