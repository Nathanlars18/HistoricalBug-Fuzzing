{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:historicalbug-fuzzing:schema:harness-spec-review-record:1.1",
  "title": "HarnessSpec Human Review Record v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "review_revision", "parent_review_ref", "subject", "rules_ref", "decision", "findings", "reviewer_id", "reviewed_at", "review_notes"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "review_revision": {"type": "integer", "minimum": 1},
    "parent_review_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "review_revision", "content_hash", "relative_path"],
          "properties": {
            "review_id": {"type": "string", "minLength": 1},
            "review_revision": {"type": "integer", "minimum": 1},
            "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "relative_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "revision_number", "content_hash", "relative_path"],
      "properties": {
        "spec_id": {"type": "string", "minLength": 1},
        "revision_number": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relative_path": {"type": "string", "minLength": 1}
      }
    },
    "rules_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "content_hash", "relative_path"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"enum": ["1.2", "1.3"]},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relative_path": {"type": "string", "minLength": 1}
      }
    },
    "decision": {"enum": ["approved", "needs_revision"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "severity", "field_path", "evidence_ref", "mismatch_summary"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^HR-(0[1-9]|10)$"},
          "severity": {"enum": ["blocking", "advisory"]},
          "field_path": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": ["string", "null"], "minLength": 1},
          "mismatch_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_notes": {"type": ["string", "null"], "minLength": 1}
  }
}
