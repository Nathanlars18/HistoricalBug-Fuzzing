{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:historicalbug-fuzzing:schema:harness-spec-record:2.2",
  "title": "HistoricalBug-Fuzzing HarnessSpec Record v2.2",
  "allOf": [
    {"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2"},
    {
      "properties": {
        "schema_version": {"const": "2.2"},
        "knowledge_plan": {
          "properties": {
            "knowledge_decisions": {"items": {"required": ["component_mappings"]}}
          }
        },
        "exploration_plan": {
          "properties": {
            "branches": {"items": {"required": ["input_validity_basis", "exploration_goal_source_refs"]}}
          }
        },
        "revision_information": {
          "properties": {"lifecycle_status": {"const": "draft"}}
        },
        "provenance": {
          "required": ["schema_ref", "schema_core_ref", "generation_trace_ref"],
          "properties": {
            "script_ref": {"allOf": [{"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2#/$defs/artifact_reference"}, {"required": ["relative_path"]}]},
            "contract_ref": {"allOf": [{"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2#/$defs/artifact_reference"}, {"required": ["relative_path"]}]},
            "rules_ref": {"allOf": [{"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2#/$defs/artifact_reference"}, {"required": ["relative_path"]}]},
            "schema_ref": {"allOf": [{"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2#/$defs/artifact_reference"}, {"required": ["relative_path"]}]},
            "schema_core_ref": {"allOf": [{"$ref": "urn:historicalbug-fuzzing:schema:harness-spec-record-core:2.2#/$defs/artifact_reference"}, {"required": ["relative_path"]}]}
          }
        },
        "review": {
          "properties": {
            "human_review_status": {"const": "not_reviewed"},
            "reviewer_id": {"type": "null"},
            "reviewed_at": {"type": "null"},
            "review_notes": {"type": "null"}
          }
        }
      }
    }
  ]
}
