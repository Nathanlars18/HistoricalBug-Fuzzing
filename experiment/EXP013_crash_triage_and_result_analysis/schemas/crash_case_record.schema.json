      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_code",
        "blocking",
        "status",
        "details",
        "resolution",
        "evidence_refs"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/identifier"
        },
        "question_code": {
          "$ref": "#/$defs/identifier"
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "details": {
          "$ref": "#/$defs/non_empty_string"
        },
        "resolution": {
          "$ref": "#/$defs/nullable_non_empty_string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/artifact_reference_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          },
          "else": {
            "properties": {
              "resolution": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "validation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "issue_code",
        "instance_path",
        "message"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "issue_code": {
          "$ref": "#/$defs/identifier"
        },
        "instance_path": {
          "$ref": "#/$defs/json_pointer"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator_version",
        "validated_at",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "validator_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/version_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "validated_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "validator_version": {
                "type": "null"
              },
              "validated_at": {
                "type": "null"
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "validator_version": {
                "$ref": "#/$defs/version_string"
              },
              "validated_at": {
                "$ref": "#/$defs/timestamp"
              },
              "issues": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "severity": {
                        "const": "error"
                      }
                    },
                    "required": [
                      "severity"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "validator_version": {
                "$ref": "#/$defs/version_string"
              },
              "validated_at": {
                "$ref": "#/$defs/timestamp"
              },
              "issues": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_artifact_ref",
        "canonicalization_version",
        "generated_at"
      ],
      "properties": {
        "builder_artifact_ref": {
          "$ref": "#/$defs/artifact_reference"
        },
        "canonicalization_version": {
          "$ref": "#/$defs/version_string"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
